<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_terminal_session_sheet"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/label_terminal_sessions"
                android:textColor="@color/neon_violet_soft"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/session_sheet_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/glass_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/session_sheet_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_icon_button"
            android:contentDescription="@string/action_new_session"
            android:src="@drawable/ic_new_session"
            android:tint="@color/neon_violet_soft" />
    </LinearLayout>

    <ListView
        android:id="@+id/terminal_sessions_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:choiceMode="singleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:longClickable="true"
        android:maxHeight="420dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none" />
</LinearLayout>
