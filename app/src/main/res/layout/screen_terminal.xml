<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/terminal_premium_header"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_action_pill"
            android:gravity="center"
            android:text="D"
            android:textColor="@color/neon_violet_soft"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="DEVBOX  /  CONSOLE"
                android:textColor="@color/neon_violet_soft"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/terminal_session_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Local shell"
                android:textColor="@color/glass_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/terminal_session_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_premium_card"
            android:gravity="center"
            android:minWidth="60dp"
            android:paddingHorizontal="10dp"
            android:text="01  ˅"
            android:textColor="@color/glass_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/activity_termux_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/deep_black">

        <RelativeLayout
            android:id="@+id/activity_termux_root_relative_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_terminal_canvas"
            android:clipToOutline="true"
            android:padding="6dp">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/terminal_toolbar_view_pager"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/terminal_toolbar_view_pager"
                android:layout_width="match_parent"
                android:layout_height="37.5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_terminal_keys_dock"
                android:clipToOutline="true"
                android:visibility="gone" />
        </RelativeLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/terminal_bottom_bar_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/terminal_bottom_bar_bottom_margin"
        android:background="@drawable/bg_terminal_glass_bar"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/terminal_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/terminal_bottom_bar_height"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />
    </LinearLayout>
</LinearLayout>
